{
  "name": "@adobe/aem-boilerplate",
  "private": true,
  "version": "1.3.0",
  "description": "Starter project for Adobe Helix",
  "scripts": {
    "test": "node --test tools/experimentation-demo/*.test.mjs && npm run test:helpers && npm run test:experimentation-ui",
    "test:experimentation-ui": "node --test tools/experimentation-ui-tests/*.test.mjs",
    "test:helpers": "cd tools/coworker-experimentation && PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -p 'test_*.py'",
    "lint:js": "eslint . && eslint \"tools/experimentation-demo/*.mjs\" \"tools/experimentation-ui-tests/*.mjs\"",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\" \"tools/plugins/experimentation/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "start": "aem up",
    "install:dropins": "node build.mjs && node postinstall.js",
    "postinstall": "npm run install:dropins",
    "postupdate": "npm run install:dropins"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-boilerplate.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-boilerplate/issues"
  },
  "homepage": "https://github.com/adobe/aem-boilerplate#readme",
  "devDependencies": {
    "@babel/eslint-parser": "7.29.7",
    "@dropins/build-tools": "1.2.1",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "stylelint": "17.14.0",
    "stylelint-config-standard": "40.0.0"
  },
  "dependencies": {
    "@adobe/adobe-client-data-layer": "3.0.1",
    "@adobe/magento-storefront-event-collector": "1.18.0",
    "@adobe/magento-storefront-events-sdk": "1.18.0",
    "@dropins/storefront-auth": "4.1.0",
    "@dropins/storefront-cart": "3.4.0",
    "@dropins/storefront-pdp": "3.3.2",
    "@dropins/storefront-personalization": "3.2.2",
    "@dropins/storefront-product-discovery": "3.1.2",
    "@dropins/storefront-wishlist": "3.5.0",
    "@dropins/tools": "2.1.0"
  },
  "overrides": {
    "@adobe/alloy": {
      "@rollup/plugin-terser": {
        "serialize-javascript": "7.0.5"
      }
    }
  }
}
